]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{d53de5c5-6a52-429e-881d-8c0d79a39c59}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ipTexts := Texts;
]]></ST>
        </Implementation>
      </Set>
    </Property>
