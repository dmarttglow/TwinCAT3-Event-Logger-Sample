      <Declaration><![CDATA[PROPERTY Formatter : I_TextFormatter]]></Declaration>
      <Get Name="Get" Id="{b4bee6bc-eefe-46fb-8874-49e70efa9fd3}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Formatter := _ipFormatter;
]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{a2b8511e-8bbe-441d-a293-61809fb1c441}">
