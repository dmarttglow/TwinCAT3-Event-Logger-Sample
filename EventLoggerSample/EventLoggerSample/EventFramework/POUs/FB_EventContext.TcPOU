<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.26">
  <POU Name="FB_EventContext" Id="{d1caea09-763a-4400-95a8-32d8d88b23a9}" SpecialFunc="None">
    <Declaration><![CDATA[// Composition of the event services, built once in a composition root (see GVL_EventDefaults).
// The setters let an application swap a single service; set them before the first event is raised.
FUNCTION_BLOCK FB_EventContext IMPLEMENTS I_EventContext
VAR
	_ipTexts		: I_TextProvider;
	_ipLanguage		: I_LanguageProvider;
	_ipFormatter	: I_TextFormatter;
	_ipEventEntries	: I_EventEntryProvider;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{f6f1e899-e3f4-4807-968a-9a090c7898d9}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains	: BOOL;
	bInCopyCode		: BOOL;
	ipTexts			: I_TextProvider;
	ipLanguage		: I_LanguageProvider;
	ipFormatter		: I_TextFormatter;
	ipEventEntries	: I_EventEntryProvider;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_ipTexts := ipTexts;
_ipLanguage := ipLanguage;
_ipFormatter := ipFormatter;
_ipEventEntries := ipEventEntries;
]]></ST>
      </Implementation>
    </Method>
