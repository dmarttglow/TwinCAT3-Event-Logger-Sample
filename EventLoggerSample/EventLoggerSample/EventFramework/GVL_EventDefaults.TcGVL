<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.26">
  <GVL Name="GVL_EventDefaults" Id="{973c5d42-c5a9-4ade-9d30-b843eb6c0f5b}">
    <Declaration><![CDATA[// Default composition root: used by every catalog event that has no Context of its own.
// Fully wired: an application needs no setup of its own.
// Replace any part at startup, e.g.  GVL_EventDefaults.fbContext.Texts := fbCsvTexts;
{attribute 'qualified_only'}
VAR_GLOBAL
	fbDefinitionTexts	: FB_DefinitionTextProvider;
	fbLanguage			: FB_LanguageSelector;
	fbFormatter			: FB_PlaceholderFormatter;
	fbEventClass		: FB_GenericEventClass;
	fbContext			: FB_EventContext(ipTexts := fbDefinitionTexts,
										  ipLanguage := fbLanguage,
										  ipFormatter := fbFormatter,
										  ipEventEntries := fbEventClass);
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
